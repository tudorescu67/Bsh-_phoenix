DISCORD_TOKEN=token_tau_aici
CLIENT_ID=id_bot_aici
GUILD_ID=id_server_aici

JARVIS_API_URL=http://127.0.0.1:5055
JARVIS_API_TOKEN=schimba-tokenul
JARVIS_PUBLIC_URL=https://jarvis.bsh.net

# BSH Media Library din bot (/media upload/list/download)
BSH_CONTROL_API_URL=https://games-api.bsh.net
BSH_BOT_MEDIA_TOKEN=schimba-token-media-lung
BOT_MEDIA_DISCORD_MAX_BYTES=26214400

# Jarvis Discord Voice Assistant
JARVIS_VOICE_ENABLED=true
JARVIS_VOICE_LANGUAGE=ro
JARVIS_VOICE_WAKE_REQUIRED=false
JARVIS_VOICE_WAKE_WORDS=jarvis,gervis,bsh
JARVIS_VOICE_TEXT_LOG=true
JARVIS_VOICE_OUTPUT_VOLUME=0.8
JARVIS_VOICE_EFFECTS_ENABLED=true
JARVIS_VOICE_EFFECT_PRESET=warm-human
# Preseturi: clean, warm-human, radio, club, deep-bass, space-reverb
# JARVIS_VOICE_FFMPEG_FILTER=highpass=f=75,lowpass=f=13500,bass=g=3:f=115:w=0.6,acompressor=threshold=-18dB:ratio=2.3,loudnorm=I=-16:TP=-1.5:LRA=11
# Voice profile doar cu acord explicit al persoanei care a dat sample-ul.
# JARVIS_VOICE_PROFILE_ID=
# JARVIS_VOICE_PROFILE_CONSENT=false
JARVIS_VOICE_TTS_STYLE=natural, warm, human, radio-ready
# JARVIS_VOICE_AUTO_CHANNEL_ID=
# JARVIS_VOICE_AUTO_TEXT_CHANNEL_ID=
# JARVIS_VOICE_STT_COMMAND=/opt/bsh/whisper.cpp/build/bin/whisper-cli
# JARVIS_VOICE_STT_ARGS=-m /opt/bsh/whisper.cpp/models/ggml-small.bin -l ro -f {file} -otxt -of {base}
# JARVIS_VOICE_STT_OUTPUT={base}.txt

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1
AI_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Music stable mode pe VPS Linux
MUSIC_USE_COOKIES=false
MUSIC_STABLE_MODE=true
MUSIC_STREAM_TIMEOUT_MS=22000
MUSIC_BACKGROUND_CACHE=true
MUSIC_DEFAULT_VOLUME=85
MUSIC_MAX_CACHE_MB=20480
MUSIC_MATCH_THRESHOLD=45
MUSIC_CACHE_DIR=/opt/bsh-stack/cache/music
MUSIC_LIBRARY_DIR=/opt/bsh-stack/music-library
MUSIC_NORMALIZE_AUDIO=true
MUSIC_FFMPEG_FILTER=aresample=async=1:first_pts=0,loudnorm=I=-16:TP=-1.5:LRA=11

# Audit si giveaway
ACTION_LOG_MAX=1000
GIVEAWAY_MAX_MINUTES=43200
GIVEAWAY_MAX_WINNERS=20
