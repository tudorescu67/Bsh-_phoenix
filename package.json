{
  "name": "discord-bot-full",
  "version": "1.0.0",
  "description": "Full-featured Discord bot",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check:syntax": "node scripts/check-syntax.cjs",
    "music:fallback": "python3 scripts/vps_music_bot.py",
    "verify:discord": "node scripts/check-discord-runtime.js",
    "deploy": "node deploy-commands.js",
    "setup:browser": "node -e \"console.log('Install Chromium or Chrome on the server and set PUPPETEER_EXECUTABLE_PATH, for example /usr/bin/chromium')\""
  },
  "dependencies": {
    "@discordjs/builders": "1.14.1",
    "@discordjs/collection": "2.1.1",
    "@discordjs/formatters": "0.6.2",
    "@discordjs/rest": "2.6.3",
    "@discordjs/util": "1.2.0",
    "@discordjs/voice": "0.19.2",
    "@discordjs/ws": "2.0.4",
    "@sapphire/snowflake": "3.5.5",
    "axios": "^1.18.1",
    "chalk": "^6.0.0",
    "discord-html-transcripts": "^3.3.0",
    "discord-api-types": "0.38.52",
    "discord.js": "14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.0",
    "libsodium-wrappers": "^0.8.4",
    "moment": "^2.30.1",
    "ms": "^2.1.3",
    "node-cron": "^4.6.0",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "prism-media": "^1.3.5",
    "puppeteer-core": "^25.4.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ytdl-core": "^4.11.5"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}

